{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OSCC",
  "version": "0.1.0",
  "identifier": "th.hospital.oscc",
  "build": {
    "beforeDevCommand": { "script": "trunk serve --port 1420", "cwd": "../app" },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": { "script": "trunk build", "cwd": "../app" },
    "frontendDist": "../app/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "OSCC",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:8080 ws://localhost:1420 http://localhost:1420; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Medical",
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
